# Copy to bot/.env. Environment variables override this file.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Written by scripts/demo-chain.sh (local) or script/Deploy.s.sol (real chains).
DEPLOYMENTS=../deployments/31337.json

# The bot never sends a transaction unless this is false.
DRY_RUN=true
# Required when DRY_RUN=false: the key of the executor's owner. Never commit it.
# For the local demo chain only, anvil's well-known account 0:
# OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

POLL_MS=3000
PORT=8787
# Where the dashboard runs (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safety: floor under quoted profit (basis points of slippage), blocks until a trade expires, gas price cap.
SLIPPAGE_BPS=1000
EXPIRY_BLOCKS=3
MAX_GAS_PRICE_GWEI=50

# Per-token limits by symbol, in token units. Default max size is 1000 units, default minimum net profit is 0.
MIN_NET_PROFIT_WETH=0.0001
MAX_AMOUNT_IN_WETH=10
MIN_NET_PROFIT_USDC=0.5
MAX_AMOUNT_IN_USDC=30000

# true keeps profit as ERC-6909 claims in the PoolManager (cheaper after the first trade).
PROFIT_AS_CLAIM=true

# Orders can carry maker hooks: code the maker chose that runs inside your trade. Skipped unless this is true.
ALLOW_HOOKED_ORDERS=false
